# docker/docker-compose.canvas-candidate.yml 的密钥来源。
# 用法：复制本文件为 docker/.env 并填入真实值（docker/.env 已被 git 忽略，不会入库）。
# 未配置时服务按 fail-closed 设计拒绝启动，属于预期行为。

# JWT 签名密钥：随机长字符串（≥32 位，勿用弱口令/占位词）
JWT_SECRET=

# 首次启动 bootstrap 管理员密码（仅当数据库里还没有管理员时生效；需强密码）
ADMIN_BOOTSTRAP_PASSWORD=

# 资产访问 URL 签名密钥：随机长字符串（留空则回退 JWT_SECRET 派生，建议独立设置）
ASSET_URL_SIGNING_SECRET=

# ---- 以下为可选覆盖（compose 内已带 10 人内网推荐默认值）----
# GENERATION_GLOBAL_CONCURRENCY=4
# GENERATION_DOMAIN_CONCURRENCY=1
# GENERATION_DOMAIN_START_INTERVAL_MS=2000
# GENERATION_MAX_QUEUED=60
# GENERATION_MAX_USER_NONTERMINAL=3
